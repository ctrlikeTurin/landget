PORT=3000
NODE_ENV=development
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
DB_PATH=./data/landlink.db
# Optional: enables the AI assistant. Leave empty to use the rule-based assistant.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
APP_URL=http://localhost:3000
# Seed admin
ADMIN_EMAIL=admin@landlink.local
ADMIN_PASSWORD="Admin#12345"
