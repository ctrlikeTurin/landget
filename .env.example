PORT=3000
NODE_ENV=development
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me

# --- Database ---
# Empty = local SQLite at DB_PATH. Set DATABASE_URL to use Postgres (Supabase):
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Put your database password in place of [YOUR-PASSWORD]; URL-encode special characters (# → %23, @ → %40).
DATABASE_URL=
DB_PATH=./data/landlink.db

# --- File storage ---
# Empty = local disk under ./uploads. Set both to use Supabase Storage
# (Project Settings → API: Project URL, and the service_role secret key). Buckets are created automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI assistant (optional) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
APP_URL=http://localhost:3000

# --- Seed admin ---  (quote values containing #)
ADMIN_EMAIL=admin@landlink.local
ADMIN_PASSWORD="Admin#12345"
